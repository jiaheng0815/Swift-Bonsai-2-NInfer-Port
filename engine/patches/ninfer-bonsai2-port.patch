+    // after the request was admitted. The frontend compiles again -- a cache hit, since the key is
+    // this same text -- because the constraint has to be bound to the vocabulary there.
+    try {
+        (void)ninfer::text::JsonSchema::compile(schema);
+    } catch (const std::invalid_argument& error) {
+        bad_request(std::string("response_format carries a schema the engine cannot enforce: ") +
+                        error.what(),
+                    "response_format", "json_schema_invalid");
+    }
+    output.structured_output_schema = std::move(schema);

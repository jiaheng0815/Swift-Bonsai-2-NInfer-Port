+                              *parsed.generation.structured_output_schema == R"({"type":"object"})",
+                          "response_format json_object lowers to the any-object schema");
+
+        Json declared = base_request();
+        declared["response_format"] =
+            Json{{"type", "json_schema"},
+                 {"json_schema",
+                  Json{{"name", "session_title"},
+                       {"strict", true},
+                       {"schema",
+                        Json{{"type", "object"},
+                             {"properties", Json{{"title", Json{{"type", "string"}}}}},
+                             {"required", Json::array({"title"})},
+                             {"additionalProperties", false}}}}}};
+        const OpenAIChatRequest with_schema = parse(declared);
+        failures += check(with_schema.generation.structured_output_schema.has_value(),
+                          "response_format json_schema lowers to a constraint");
+        if (with_schema.generation.structured_output_schema) {
+            // The schema is carried verbatim so the frontend can cache it by text.
+            failures += check(
+                with_schema.generation.structured_output_schema->find("\"title\"") !=
+                    std::string::npos,
+                "the declared schema reaches the engine verbatim");
+        }
+
+        // A schema the engine cannot enforce is the client's 400, not an engine failure later.
+        Json unusable               = base_request();
+        unusable["response_format"] = Json{
+            {"type", "json_schema"},
+            {"json_schema", Json{{"schema", Json{{"type", "strng"}}}}}};
+        const ApiError error = api_error([&] { (void)parse(unusable); });
+        failures += check(error.code == "json_schema_invalid",
+                          "an unenforceable schema is rejected at parse time");
+
+        // A plain text response_format stays unconstrained, so the field must remain absent.
+        Json plain              = base_request();
+        plain["response_format"] = Json{{"type", "text"}};
+        failures += check(!parse(plain).generation.structured_output_schema.has_value(),
+                          "response_format text leaves the request unconstrained");
+    }

+    std::string schema;
+    if (type == "json_object") {
+        schema = R"({"type":"object"})";
+    } else if (type == "json_schema") {
+        if (!format.contains("json_schema") || !format.at("json_schema").is_object()) {
+            bad_request("response_format json_schema must contain a json_schema object",
+                        "response_format");
+        }

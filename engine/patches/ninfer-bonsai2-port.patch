+const std::uint8_t* ProgramImplCore::upload_token_mask(
+    SequenceState& sequence, const runtime::RoundConstraint& constraint) {
+    if (constraint.token_mask.empty()) {
+        // The caller has no constraint for this row this round — either the request carries none, or
+        // its constraint is dormant because the model is still in the reasoning channel.

# ============================================================
#  本仓只发布「工具与方法」——权重、制品、编译产物、第三方源码一律不入库
# ============================================================

# ---- 模型权重与制品（体积大，版权归原作者）----
*.gguf
*.ninfer
artifacts/*
!artifacts/README.md

# ---- 第三方参考副本（各自仓库另行获取）----
guide/
src/mengyou/
src/yutils/

# ---- 引擎树里不入库的部分 ----
# （说明：gitignore 的 # 注释必须独占一行，不能写在规则后面）
src/cranebw/.git/
src/cranebw/.codex/
# 指向本机 FFmpeg 的目录联接（258 MB，仅视觉/视频需要）
src/cranebw/ffmpeg/
# 36 MB 二进制测试夹具（构建不需要，可另行生成）
src/cranebw/tools/freq_corpus/fixtures/

# ---- 编译产物与本地文件 ----
build/
models/
profiles/
*.zip

# ---- 运行日志与临时数据 ----
logs/
launch/legacy/
.playwright-mcp/

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.tmp

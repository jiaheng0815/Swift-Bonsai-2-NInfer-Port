# Keep Windows scripts runnable on every checkout and text docs LF.
* text=auto

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

# Binary payloads are never included in the repo, but be explicit.
*.ninfer binary
*.gguf   binary
*.zip    binary
*.png    binary
